# ============================================================
# PAKE MAIL — .gitignore
# Next.js + TypeScript + Prisma + BullMQ + Supabase
# ============================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js
.yarn/
  !.yarn/patches
  !.yarn/plugins
  !.yarn/releases
  !.yarn/versions

# --- Next.js ---
.next/
out/
build/

# --- Production ---
dist/

# --- Environment Variables ---
.env
.env.*
!.env.example
!.env.local.example
!.env.development.example
!.env.production.example
!.env.staging.example

# --- IDE / Editor ---
.idea/
*.iml
.vscode/
  !.vscode/extensions.json
  !.vscode/settings.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# --- Debug Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Prisma ---
prisma/migrations/
  !prisma/migrations/.keep

# --- Testing ---
coverage/
.nyc_output/
*.lcov

# --- Uploads / Temp ---
public/uploads/
tmp/
temp/
*.tmp

# --- OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Vercel ---
.vercel

# --- Docker ---
docker-compose.override.yml

# --- Certificates (PEM) ---
*.pem
*.key
*.crt
*.cert

# --- Sentry / Error Tracking ---
.sentryclirc

# --- Turborepo ---
.turbo

# --- Misc ---
*.log
*.bak
*.orig